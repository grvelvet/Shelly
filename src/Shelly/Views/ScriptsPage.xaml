<UserControl x:Class="Shelly.Views.ScriptsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Shelly.Views">
    <UserControl.Resources>
        <!-- Group header: folder, root scripts or favorites (a section title like Windows Settings, no card) -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type v:GroupRow}">
            <Grid Height="32" Background="Transparent" ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Chevron}" FontSize="12" Width="16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16" Width="16" Margin="9,0,20,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding CountText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Shared by both views. Status cluster: three fixed slots (engine, warnings, last run) right before the row buttons, so
             the marks form columns down the list; an empty slot keeps its width. Tooltips sit on the slot, not on the glyph. -->
        <DataTemplate x:Key="StatusTemplate" DataType="{x:Type v:ScriptRow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Visibility="{DynamicResource SlotEngineVis}">
                    <Border Style="{StaticResource StatusSlot}" Width="48" ToolTip="{Binding EngineTip}"
                            Visibility="{Binding ShowEngine, Converter={StaticResource BoolHidden}}">
                        <TextBlock Text="{Binding EngineMark}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EngineMissing}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Border>
                <Border Visibility="{DynamicResource SlotDangerVis}">
                    <Border Style="{StaticResource StatusSlot}" ToolTip="{Binding DangerTip}"
                            Visibility="{Binding HasDanger, Converter={StaticResource BoolHidden}}">
                        <TextBlock Text="{Binding DangerGlyph}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Danger}" Value="high">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Danger}" Value="motw">
                                            <Setter Property="Foreground" Value="{DynamicResource ShellyMotwBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Danger}" Value="checking">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Danger}" Value="unverified">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Border>
                <Border Visibility="{DynamicResource SlotLastVis}">
                    <Border Style="{StaticResource StatusSlot}" ToolTip="{Binding LastTip}"
                            Visibility="{Binding HasLast, Converter={StaticResource BoolHidden}}">
                        <TextBlock Text="{Binding LastGlyph}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastKind}" Value="ok">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LastKind}" Value="fail">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LastKind}" Value="stopped">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Row buttons: Run and Run settings on hover / selection; while running, the time and Stop -->
        <DataTemplate x:Key="ActionsTemplate" DataType="{x:Type v:ScriptRow}">
            <Grid Width="96">
                <StackPanel Style="{StaticResource HoverActions}" HorizontalAlignment="Right"
                            Visibility="{Binding NotRunning, Converter={StaticResource BoolVis}}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" Click="RowRun" Tag="{Binding}"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            ToolTip="{Binding [runTip], Source={x:Static v:L.I}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="RowSettings" Tag="{Binding}"
                            ToolTip="{Binding [rsTip], Source={x:Static v:L.I}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                    <TextBlock Style="{StaticResource Spinner}" />
                    <TextBlock Text="{Binding Elapsed}" FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center" MinWidth="34"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Click="RowStop" Tag="{Binding}"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            ToolTip="{Binding [rowStopTip], Source={x:Static v:L.I}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Script row, Cards view: a 64 px card, name over the description -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type v:ScriptRow}">
            <Grid Height="64" Background="Transparent" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" Margin="16,0,0,0" Background="Transparent" ToolTip="{Binding [rowIconTip], Source={x:Static v:L.I}}">
                    <Border CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                    <!-- HugPanel, not a horizontal StackPanel: the name trims with an ellipsis, the favorite star stays right after it -->
                    <v:HugPanel>
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <!-- Marks right after the name: the folder of an imported folder (a script with its own files), the favorite star, the schedule clock -->
                        <StackPanel Orientation="Horizontal">
                            <!-- The tooltip sits on the Border, not on the glyph (the symbol font must not reach the tooltip) -->
                            <Border Background="Transparent" ToolTip="{Binding ProjectTip}" Margin="6,1,0,0"
                                    Visibility="{Binding InProject, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE735;" FontSize="11" Margin="6,1,0,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}" />
                            <!-- 1.2.0: on a schedule -->
                            <Border Background="Transparent" ToolTip="{Binding ScheduleTip}" Margin="6,1,0,0"
                                    Visibility="{Binding HasSchedule, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE121;" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <!-- 1.4.0: trusted script badge -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="5,1,5,1" Margin="6,1,0,0"
                                    ToolTip="{Binding TrustedTip}" Visibility="{Binding IsTrusted, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding TrustedLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            </Border>
                        </StackPanel>
                    </v:HugPanel>
                    <TextBlock Text="{Binding Desc}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDesc, Converter={StaticResource BoolVis}}" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" />
                <ContentPresenter Grid.Column="3" Margin="4,0,12,0" Content="{Binding}" ContentTemplate="{StaticResource ActionsTemplate}" />
            </Grid>
        </DataTemplate>

        <!-- Script row, Compact list view: one 40 px line (icon, name, description inline), no card -->
        <DataTemplate x:Key="CompactTemplate" DataType="{x:Type v:ScriptRow}">
            <Grid Height="40" Background="Transparent" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" Margin="16,0,0,0" Background="Transparent" ToolTip="{Binding [rowIconTip], Source={x:Static v:L.I}}">
                    <Border CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}" />
                </Grid>
                <!-- The description gives way first: the name keeps its width until it no longer fits, then trims too -->
                <DockPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" LastChildFill="True">
                    <v:HugPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <!-- Marks right after the name: the folder of an imported folder (a script with its own files), the favorite star, the schedule clock -->
                        <StackPanel Orientation="Horizontal">
                            <!-- The tooltip sits on the Border, not on the glyph (the symbol font must not reach the tooltip) -->
                            <Border Background="Transparent" ToolTip="{Binding ProjectTip}" Margin="6,1,0,0"
                                    Visibility="{Binding InProject, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE735;" FontSize="11" Margin="6,1,0,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}" />
                            <!-- 1.2.0: on a schedule -->
                            <Border Background="Transparent" ToolTip="{Binding ScheduleTip}" Margin="6,1,0,0"
                                    Visibility="{Binding HasSchedule, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE121;" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <!-- 1.4.0: trusted script badge -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="5,1,5,1" Margin="6,1,0,0"
                                    ToolTip="{Binding TrustedTip}" Visibility="{Binding IsTrusted, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding TrustedLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            </Border>
                        </StackPanel>
                    </v:HugPanel>
                    <TextBlock Text="{Binding Desc}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="12,1,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDesc, Converter={StaticResource BoolVis}}" />
                </DockPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" />
                <ContentPresenter Grid.Column="3" Margin="4,0,8,0" Content="{Binding}" ContentTemplate="{StaticResource ActionsTemplate}" />
            </Grid>
        </DataTemplate>

        <v:RowTemplateSelector x:Key="CardTemplates" Group="{StaticResource GroupTemplate}" Script="{StaticResource CardTemplate}" />
        <v:RowTemplateSelector x:Key="CompactTemplates" Group="{StaticResource GroupTemplate}" Script="{StaticResource CompactTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="36,24,36,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="OutputRow" Height="240" />
        </Grid.RowDefinitions>

        <!-- Header: title, commands left of the search box, refresh and folders -->
        <DockPanel x:Name="Header" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Text="{Binding [title], Source={x:Static v:L.I}}" Margin="0,0,24,0" />
            <StackPanel x:Name="RightBtns" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshBtn" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="4,0,0,0"
                        ToolTip="{Binding [refreshTip], Source={x:Static v:L.I}}" />
                <Button x:Name="FoldersBtn" Style="{StaticResource IconButton}" Content="&#xE8B7;"
                        ToolTip="{Binding [foldersTip], Source={x:Static v:L.I}}" />
            </StackPanel>
            <StackPanel x:Name="CmdBtns" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="NewScriptBtn" Style="{StaticResource IconButton}" Content="&#xE710;"
                        ToolTip="{Binding [newTip], Source={x:Static v:L.I}}" />
                <Button x:Name="NewFolderBtn" Style="{StaticResource IconButton}" Content="&#xE8F4;"
                        ToolTip="{Binding [newFolderTip], Source={x:Static v:L.I}}" />
                <!-- Toolbar (Explorer-like): create | sort, collapse / expand all, view, filter. Widths: Layout.ToolbarFull -->
                <Rectangle Width="1" Height="16" Margin="8,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <StackPanel x:Name="ViewTools" Orientation="Horizontal">
                    <Button x:Name="SortBtn" Style="{StaticResource IconButton}" Content="&#xE8CB;" />
                    <Button x:Name="CollapseBtn" Style="{StaticResource IconButton}" Content="&#xF165;" />
                    <Button x:Name="ViewBtn" Style="{StaticResource IconButton}" Content="&#xECA5;" />
                    <Grid>
                        <Button x:Name="FilterBtn" Style="{StaticResource IconButton}" Content="&#xE71C;" />
                        <Ellipse x:Name="FilterDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                 IsHitTestVisible="False" Visibility="Collapsed" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Grid>
                </StackPanel>
                <!-- Narrow window: sort, collapse, view and filter move into this menu before the search box turns into a button -->
                <Grid x:Name="MoreTools" Visibility="Collapsed">
                    <Button x:Name="MoreBtn" Style="{StaticResource IconButton}" Content="&#xE712;"
                            ToolTip="{Binding [moreToolsTip], Source={x:Static v:L.I}}" />
                    <Ellipse x:Name="MoreDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                             IsHitTestVisible="False" Visibility="Collapsed" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                </Grid>
                <Border Width="8" />
                <!-- Narrow window: the box shrinks with the header, then turns into this button, which opens the box over the header -->
                <Button x:Name="SearchBtn" Style="{StaticResource IconButton}" Content="&#xE721;" Visibility="Collapsed"
                        ToolTip="{Binding [searchOpenTip], Source={x:Static v:L.I}}" />
                <Grid x:Name="SearchBox" Width="340">
                    <TextBox x:Name="Omni" MinHeight="32" Padding="34,5,10,5" VerticalContentAlignment="Center"
                             ToolTip="{Binding [omniTip], Source={x:Static v:L.I}}" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" HorizontalAlignment="Left" Margin="12,0,0,0"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="OmniHint" Text="{Binding [omniHint], Source={x:Static v:L.I}}" IsHitTestVisible="False"
                               Margin="36,0,0,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Popup x:Name="OmniPopup" PlacementTarget="{Binding ElementName=Omni}" Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" Width="340">
                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0">
                            <ListBox x:Name="OmniList" MaxHeight="320" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" v:ScrollGutter.Enabled="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,6">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" Width="20" />
                                            <TextBlock Text="{Binding Text}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </DockPanel>

        <DockPanel x:Name="SearchOverlay" Margin="0,0,0,16" Visibility="Collapsed">
            <Button x:Name="SearchClose" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="0,0,8,0" VerticalAlignment="Center"
                    ToolTip="{Binding [searchCloseTip], Source={x:Static v:L.I}}" />
            <Grid x:Name="SearchSlot" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1">
        <!-- Active filters: "Filters: N · Clear" (the filter names in the tooltip) -->
        <Border x:Name="FilterChip" Visibility="Collapsed" HorizontalAlignment="Left" CornerRadius="4" BorderThickness="1" Padding="12,0,4,0"
                Margin="0,0,0,12" MinHeight="32" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" Margin="0,0,8,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="FilterChipText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="·" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button x:Name="FilterClearBtn" VerticalAlignment="Center" Padding="8,2" MinHeight="24" FontSize="12"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Content="{Binding [filtersClear], Source={x:Static v:L.I}}" ToolTip="{Binding [filtersClearTip], Source={x:Static v:L.I}}" />
            </StackPanel>
        </Border>
        <!-- Info bar: update, PowerShell 7 offer, compatibility notes -->
        <Border x:Name="InfoBar" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" Padding="16,8" Margin="0,0,0,12"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <TextBlock x:Name="InfoGlyph" Style="{StaticResource Glyph}" Text="&#xE946;" Margin="0,0,12,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Button x:Name="InfoClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" v:Ico.Size="11"
                        ToolTip="{Binding [dismiss], Source={x:Static v:L.I}}" />
                <Button x:Name="InfoAction" DockPanel.Dock="Right" Margin="12,0,4,0" Style="{DynamicResource AccentButtonStyle}" />
                <Button x:Name="InfoAction2" DockPanel.Dock="Right" Margin="12,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- v:ScrollGutter keeps the cards out from under the overlay scroll bar of the Fluent ScrollViewer -->
            <ListBox x:Name="List" BorderThickness="0" Padding="0" Background="Transparent" ItemContainerStyleSelector="{StaticResource RowStyles}"
                     v:ScrollGutter.Enabled="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" />
            <v:EmptyState x:Name="Empty" Visibility="Collapsed" />
        </Grid>

        <GridSplitter x:Name="Splitter" Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"
                      Cursor="SizeNS" Margin="0,4,0,4" />
        <v:OutputView x:Name="Output" Grid.Row="4" />

        <!-- Shown while files are dragged over the page -->
        <Border x:Name="DropOverlay" Grid.RowSpan="5" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="8" BorderThickness="2"
                Margin="-12,-8,-12,-4" Opacity="0.94" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding [dropHint], Source={x:Static v:L.I}}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding [dropHintNote], Source={x:Static v:L.I}}" FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
