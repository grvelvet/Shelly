<Window x:Class="Shelly.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Shelly.Views"
        Title="Shelly" Width="1100" Height="760" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="/Shelly;component/Assets/shelly.ico">
    <!-- One cell: pane and content layer side by side. Widths and margins come from Layout.PaneOpen / PaneCompact in
         code (MainWindow.SetPane), never from numbers here. Inline the pane is plain Mica; the layer slides with a
         render transform and its margin changes once per open/close. Overlay: the pane gets a flyout surface + shadow. -->
    <Grid x:Name="Root">
        <!-- Light-dismiss layer while the pane is open over the content -->
        <Border x:Name="Scrim" Background="Transparent" Visibility="Collapsed" Panel.ZIndex="1" />

        <Grid x:Name="Pane" HorizontalAlignment="Left" Panel.ZIndex="2" ClipToBounds="False">
            <!-- Overlay surface: only while the pane lies over the page. Opaque flyout color and a soft shadow, no stroke frame -->
            <Border x:Name="PaneSurface" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="0,8,8,0"
                    Background="{DynamicResource ShellyPaneOverlayBrush}">
                <Border.Effect>
                    <DropShadowEffect x:Name="PaneShadow" BlurRadius="24" ShadowDepth="0" Opacity="0" Color="Black" RenderingBias="Performance" />
                </Border.Effect>
            </Border>
            <DockPanel x:Name="Nav" ClipToBounds="True">
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="MenuBtn" Style="{StaticResource IconButton}" Content="&#xE700;" Width="40" Height="36"
                            HorizontalAlignment="Left" Margin="4,4,0,4"
                            ToolTip="{Binding [navMenuTip], Source={x:Static v:L.I}}" />
                    <RadioButton x:Name="NavScripts" Style="{StaticResource NavItem}" Tag="&#xE756;" IsChecked="True"
                                 Content="{Binding [navScripts], Source={x:Static v:L.I}}" ToolTip="{Binding [navScriptsTip], Source={x:Static v:L.I}}" />
                    <RadioButton x:Name="NavFavorites" Style="{StaticResource NavItem}" Tag="&#xE734;"
                                 Content="{Binding [navFavorites], Source={x:Static v:L.I}}" ToolTip="{Binding [navFavoritesTip], Source={x:Static v:L.I}}" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="&#xE81C;"
                                 Content="{Binding [navHistory], Source={x:Static v:L.I}}" ToolTip="{Binding [navHistoryTip], Source={x:Static v:L.I}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <RadioButton x:Name="NavCompat" Style="{StaticResource NavItem}" Tag="&#xE9D9;"
                                 Content="{Binding [navCompat], Source={x:Static v:L.I}}" ToolTip="{Binding [compatCheckTip], Source={x:Static v:L.I}}" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;"
                                 Content="{Binding [navSettings], Source={x:Static v:L.I}}" ToolTip="{Binding [settingsTip], Source={x:Static v:L.I}}" />
                </StackPanel>
                <Border />
            </DockPanel>
            <!-- One selection indicator for the whole pane: it slides to the selected item -->
            <Border x:Name="NavPill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="4,0,0,0" IsHitTestVisible="False" Background="{DynamicResource AccentFillColorDefaultBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PillMove" />
                </Border.RenderTransform>
            </Border>
        </Grid>

        <!-- Content layer (WinUI NavigationView content grid): its own plane on Mica, LayerFillColorDefault with a 1 px
             stroke on the top and left and an 8 px top-left corner, below the 48 px title row and right of the pane.
             The pane and the title row stay transparent on Mica. The status line lives inside the layer. -->
        <Border x:Name="Body" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource ShellyLayerFillBrush}" BorderBrush="{DynamicResource ShellyLayerStrokeBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="Pages" />
                <DockPanel x:Name="StatusBar" Grid.Row="1" Height="32" Margin="36,0,36,0">
                    <TextBlock x:Name="RunningText" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
