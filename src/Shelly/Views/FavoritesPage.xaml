<UserControl x:Class="Shelly.Views.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Shelly.Views">
    <Grid Margin="36,24,36,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [navFavorites], Source={x:Static v:L.I}}" HorizontalAlignment="Left" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:ScriptRow}">
                        <Border x:Name="Tile" Width="248" Height="132" Margin="0,0,8,8" CornerRadius="8" BorderThickness="1" Padding="16,12,8,8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="900" Tag="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Grid Width="32" Height="32" DockPanel.Dock="Left" Margin="0,0,12,0">
                                        <Border CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <Image Source="{Binding Icon}" Width="28" Height="28" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Desc}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <DockPanel Grid.Row="2">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                                            <TextBlock Style="{StaticResource Spinner}" />
                                            <TextBlock Text="{Binding Elapsed}" FontSize="12" Margin="6,0,2,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Click="TileStop" Tag="{Binding}"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}" ToolTip="{Binding [rowStopTip], Source={x:Static v:L.I}}" />
                                        </StackPanel>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" Click="TileRun" Tag="{Binding}"
                                                Visibility="{Binding NotRunning, Converter={StaticResource BoolVis}}"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip="{Binding [runTip], Source={x:Static v:L.I}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="TileSettings" Tag="{Binding}"
                                                ToolTip="{Binding [rsTip], Source={x:Static v:L.I}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastLine}" ToolTip="{Binding LastTip}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <v:EmptyState x:Name="Empty" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</UserControl>
