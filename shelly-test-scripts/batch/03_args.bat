@echo off
:: Описание: Аргументы bat-файла: %1..%9, %*, кавычки и пробелы
:: Shelly-Icon: E765
::
:: Поле «Аргументы» в параметрах запуска (Ctrl+I). Попробуйте:
::   один "два слова" три        -> 3 аргумента, второй с пробелом (кавычки снимаются через %%~1)
::   (пусто)                     -> «Аргументов нет»
::   50%                         -> Shelly откажет до запуска: символы " % ^ внутри значения нельзя
:: Сохраните пресет («Сохранить как…») и запустите его из меню строки и из избранного.
chcp 65001 >nul
setlocal
if "%~1"=="" (
  echo Аргументов нет.
  exit /b 0
)
echo Вся строка: %*
set n=0
:loop
if "%~1"=="" goto done
set /a n+=1
echo   [%n%] = %~1
shift
goto loop
:done
echo Всего аргументов: %n%
exit /b 0
