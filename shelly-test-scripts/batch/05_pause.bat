@echo off
:: Описание: pause и set /p: во встроенном выводе не ждут, в окне ждут клавишу
:: Shelly-Icon: E8BD
::
:: Встроенный вывод: ввода с клавиатуры нет. pause сразу продолжается
:: («Для продолжения нажмите любую клавишу...» и дальше), set /p получает пустую строку,
:: скрипт доходит до конца с кодом 0.
:: Отдельное окно: pause ждёт клавишу, set /p ждёт ввод.
chcp 65001 >nul
echo До паузы.
pause
echo После паузы.
set "name="
set /p "name=Как вас зовут? "
if "%name%"=="" (echo Имя не введено.) else (echo Привет, %name%!)
exit /b 0
